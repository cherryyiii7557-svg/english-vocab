    if (!parts[0] || !parts[2]) { skipped++; return; }
    if (existing.has(parts[0].toLowerCase())) { skipped++; return; }
    customWords.push({
      word: parts[0],
      pos: parts[1] || "",
      zh: parts[2],
      example: parts[3] || "",
      exZh: parts[4] || ""
    });
    existing.add(parts[0].toLowerCase());
