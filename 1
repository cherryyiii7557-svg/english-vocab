    hint.appendChild(speakBtn(q.w.word));
    body.appendChild(hint);
    body.appendChild(buildInputRow());
  } else if (q.type === "spell-full") {
    const hint = document.createElement("div"); hint.className = "q-hint";
    hint.innerHTML = `請依中文提示拼出完整單字：<b>「${escapeHtml(q.w.zh)}」</b>（${escapeHtml(q.w.pos || "")}）`;
    hint.appendChild(speakBtn(q.w.word));
