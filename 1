      if (!confirm(`匯入 ${data.units.length} 個單元（同名單元將被覆蓋）。確定繼續嗎？`)) return;
      data.units.forEach(nu => {
        const i = units.findIndex(u => u.unit.toLowerCase() === nu.unit.toLowerCase());
        if (i >= 0) units[i] = nu; else units.push(nu);
      });
      if (Array.isArray(data.bank)) bank = data.bank;
      saveUnits(); saveBank();
      renderUnitList(); renderStudyWordList(); renderBank();
      alert("匯入完成！");
    } catch (err) { alert("匯入失敗：" + err.message); }
    ev.target.value = "";
  };
  reader.readAsText(file);
});
document.getElementById("btnResetAll").addEventListener("click", () => {
  if (!confirm("確定要恢復預設嗎？自訂單字與學習進度都會被刪除，無法復原。")) return;
  customWords = []; progress = {};
  saveCustomWords(customWords); saveProgress(progress);
  updateStats(); buildDeck(); renderWordList();
document.getElementById("btnFactory").addEventListener("click", () => {
  if (!confirm("確定恢復預設資料嗎？所有自訂單元、修改與錯題庫都會被清除，無法復原。")) return;
  localStorage.removeItem(LS_UNITS);
  localStorage.removeItem(LS_BANK);
  units = JSON.parse(JSON.stringify(BUILTIN_UNITS));
  bank = [];
  saveUnits(); saveBank();
  renderUnitList(); renderStudyWordList(); renderBank();
});
/* ===================== 啟動 ===================== */
refreshUnitSelects();
updateStats();
buildDeck();
renderWordList();
renderStudyWordList();
renderBank();
renderUnitList();
renderPlayerNameInputs();
</script>
</body>
</html>
