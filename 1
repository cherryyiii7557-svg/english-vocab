    const key = q.type === "mc-zh" ? "zh" : "en";
    const wr = document.createElement("div"); wr.className = "q-word-row";
    const sp = document.createElement("span"); sp.className = "q-word"; sp.textContent = q.w.word;
    wr.append(sp, speakBtn(q.w.word));
    body.appendChild(wr);
    const ask = document.createElement("div"); ask.className = "q-hint";
    ask.textContent = key === "zh" ? "請選出正確的中文解釋：" : "請選出正確的英文解釋：";
    body.appendChild(ask);
    const grid = document.createElement("div"); grid.className = "q-options";
    (q.options && q.options.length === 4 ? q.options : mcOptions([], q.w, key)).forEach(opt => {
      const b = document.createElement("button"); b.className = "q-option"; b.textContent = opt;
      b.addEventListener("click", () => {
        const correct = opt === q.w[key];
        grid.querySelectorAll("button").forEach(x => { x.disabled = true; if (x.textContent === q.w[key]) x.classList.add("correct"); });
        if (!correct) b.classList.add("wrong");
        showFeedback(correct, opt);
        finish(correct, opt);
      });
      grid.appendChild(b);
    });
    body.appendChild(grid);
  } else if (q.type === "cloze") {
    const se = document.createElement("div"); se.className = "q-sentence"; se.textContent = blankSentence(q.s.en, q.w.word);
    const zh = document.createElement("div"); zh.className = "q-sentence-zh"; zh.textContent = "（句意：" + q.s.zh + "）";
    body.append(se, zh);
    body.appendChild(buildInputRow());
  }
  container.appendChild(wrap);
}
