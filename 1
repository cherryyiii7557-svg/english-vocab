  wrap.append(head, body, fb);
  let answered = false;
  function showFeedback(correct, userAnswer) {
    if (correct) { fb.className = "q-feedback ok"; fb.textContent = "✓ 回答正確！"; }
    else {
      fb.className = "q-feedback bad";
      fb.innerHTML = `✗ 回答錯誤。你的答案：「${escapeHtml(userAnswer || "（空白）")}」　正確答案：「${escapeHtml(q.w.word)}」`;
      const exp = document.createElement("div"); exp.className = "explain";
      exp.innerHTML = "<b>💡 解題思路：</b>" + escapeHtml(makeExplanation(q));
      fb.appendChild(exp);
    }
  }
  function finish(correct, userAnswer) {
    if (answered) return; answered = true;
    onResult(correct, userAnswer);
  }
  function buildInputRow(checkFn) {
    const row = document.createElement("div"); row.className = "q-input-row";
    const input = document.createElement("input");
    input.type = "text"; input.className = "q-input"; input.autocomplete = "off"; input.spellcheck = false;
    input.placeholder = "請輸入完整單字 / 詞組";
    const btn = document.createElement("button"); btn.className = "btn-primary"; btn.textContent = "確認";
    function check() {
      const v = input.value;
      const correct = norm(v) === norm(q.w.word);
      showFeedback(correct, v);
      input.disabled = true; btn.disabled = true;
      finish(correct, v);
    }
    btn.addEventListener("click", check);
    input.addEventListener("keydown", e => { if (e.key === "Enter" && !input.disabled) check(); });
    row.append(input, btn);
    setTimeout(() => input.focus(), 60);
    return row;
  }
